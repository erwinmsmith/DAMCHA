# ── Large data / model files ──────────────────────────────────────────
data/rawdata/
!data/rawdata/.gitkeep

# ── Checkpoints ───────────────────────────────────────────────────────
checkpoints/**/*.pt
checkpoints/**/*.pth
checkpoints/**/*.bin
checkpoints/**/*.ckpt
!checkpoints/**/.gitkeep

# ── Logs (keep folder structure, not content) ─────────────────────────
logs/**/*.log
logs/**/*.csv
logs/**/*.json
!logs/**/.gitkeep

# ── Outputs (metrics / visualizations / generated files) ──────────────
outputs/**/*.csv
outputs/**/*.json
outputs/**/*.png
outputs/**/*.jpg
outputs/**/*.npz
outputs/**/*.npy
!outputs/**/.gitkeep

# ── Python cache ──────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# ── Misc ──────────────────────────────────────────────────────────────
*.egg-info/
.DS_Store
nohup.out
